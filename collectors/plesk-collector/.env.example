# Ne pas versionner le fichier réel : il contient le jeton du collecteur.
# Charger ces valeurs dans le service systemd ou avant le cron.
PARRALAX_API_URL=https://dns-inventory.example.net/api/collectors/custom-dns/sync
PARRALAX_SOURCE=plesk-prod-01
PARRALAX_SOURCE_TOKEN=remplacer-par-un-secret-long-et-aleatoire

# Facultatif si les binaires ne sont pas dans PATH.
# PLESK_BIN=/usr/sbin/plesk
# JQ_BIN=/usr/bin/jq
# CURL_BIN=/usr/bin/curl
