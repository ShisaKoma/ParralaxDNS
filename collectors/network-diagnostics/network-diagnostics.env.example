PARRALAX_API_URL=https://dns.example.net/api/collectors/network-diagnostics
PARRALAX_AGENT=debian-edge-01
PARRALAX_AGENT_TOKEN=remplacer-par-un-jeton-long-et-aleatoire
PARRALAX_DOMAINS_FILE=/etc/parralax-network-diagnostics/domains.txt
PARRALAX_DIAGNOSTIC_CHECKS=dig,traceroute,netstat
PARRALAX_DIG_TIMEOUT=3
PARRALAX_TRACEROUTE_HOPS=12
PARRALAX_TRACEROUTE_WAIT=2
